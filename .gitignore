# Tool caches / IDE-local state
.antigravitycli/
__pycache__/
*.egg-info/
.pytest_cache/
# Python build output (regenerated by pip/setup.py; e.g. build/lib/dgxlib)
build/

# Generated turbovec-eval artifacts (regenerate via build-corpus.py / the
# --gen flag of turbovec-target.py). corpus.txt is large derived campaign text.
corpus.txt
queries*.jsonl
*.tv

# D&D / RPG experiments that live in this dir but belong to other projects.
# Kept out of git history; move to ~/src/CampaignGenerator or ~/src/mempalace
# if they should be tracked elsewhere.
5e-mempalace/
lora-stormgiants/
my_quest.md

# Clef / Decision 2.0 eval DATA stays local: it quotes campaign chapters verbatim and
# table-chatter labels name real people. The scripts that rebuild it are tracked.
clef/spell-pass-eval/*.json
clef/social-npc-eval/*.json
clef/social-npc-eval/review.html
clef/ensemble-typing-eval/*.json
clef/finetune/*.json
clef/finetune/*.pt
